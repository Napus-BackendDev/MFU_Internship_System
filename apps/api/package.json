    "@internship/shared-types": "workspace:*",
    "@internship/validation": "workspace:*",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
