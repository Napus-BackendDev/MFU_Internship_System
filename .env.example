# Copy values into the environment-specific file or inject them from a secret manager.
NODE_ENV=development
CONTAINERIZED=false
PORT=8081
MONGODB_URI=mongodb://localhost:27017/internship_transcript_v2_dev
REDIS_URL=redis://localhost:6379
# Explicit proxy IPs/CIDRs only; blank means ignore forwarded IP headers.
TRUSTED_PROXY_CIDRS=
PUBLIC_WEB_URL=http://localhost:8080
NUXT_PUBLIC_API_BASE_URL=http://localhost:8081/api/v2
API_INTERNAL_BASE_URL=http://localhost:8081/api/v2
CORS_ORIGINS=http://localhost:8080
AUTH_MODE=development
AUTH_JWT_SECRET=<SET_A_LONG_RANDOM_SECRET>
INVITATION_TOKEN_PEPPER=<SET_A_LONG_RANDOM_PEPPER>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=28800
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
COOKIE_SECURE=false
MAIL_DELIVERY_MODE=capture
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Internship Transcript Dev <no-reply@localhost>
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=internship-transcript-dev
S3_ACCESS_KEY_ID=<SET_LOCAL_ACCESS_KEY>
S3_SECRET_ACCESS_KEY=<SET_LOCAL_SECRET_KEY>
S3_FORCE_PATH_STYLE=true
LOG_LEVEL=debug
SMTP_SETTINGS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
